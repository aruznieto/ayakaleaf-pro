#!/usr/bin/env bash
# Usage: services/github-mock/bin/up
#
# Runs after the toolkit's bin/up, once its network exists. Starts the mock
# on that network as github.com and api.github.com, so Docker's DNS sends
# Overleaf's GitHub requests to it, and as github-mock for the tests' control
# API on port 8080.
#
# Expects TOOLKIT_DIR and TOOLKIT_NETWORK in the environment.

set -euo pipefail

cd "$(dirname "$0")/.."
state="$TOOLKIT_DIR/services/github-mock"

docker run --detach --name e2e-github-mock \
  --network "$TOOLKIT_NETWORK" \
  --network-alias github.com \
  --network-alias api.github.com \
  --network-alias github-mock \
  --env-file "$state/mock.env" \
  --volume "$PWD/server.mjs:/mock/server.mjs:ro" \
  --volume "$state:/tls:ro" \
  node:24-alpine node /mock/server.mjs

echo "Waiting for the GitHub mock..."
for _ in $(seq 30); do
  docker exec sharelatex curl -sf -o /dev/null -X POST http://github-mock:8080/_mock/reset && break
  sleep 1
done
docker exec sharelatex curl -s -o /dev/null https://api.github.com/user \
  --cacert /var/lib/overleaf/certs/github-mock-ca.pem -w "%{http_code}" \
  | grep -q 401 || { echo "The GitHub mock is not reachable as api.github.com" >&2; exit 1; }
echo "GitHub mock is up"
